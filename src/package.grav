// package.grav — how an Apogee module connects itself to an app. A module
// declares one class extending ApogeePackage; importing the module is then
// enough: the app finds the class (by reflection), applies its default
// settings, registers and boots it, runs its migrations with `migrate`, and
// adds its commands to the console.
//
//   class SanctumPackage extends ApogeePackage {
//       constructor() {}
//       fn name() -> string { return "sanctum" }
//       fn defaults() -> HashMap<string, any> { return {"sanctum.expiration": Env.getInt("SANCTUM_EXPIRATION", 0)} }
//       fn migrations() -> Array<any> { return [new CreatePersonalAccessTokensTable() as any] }
//       fn boot(app: PackageContext) {
//           let router = app.make::<Router>()
//           router.aliasMiddleware("abilities", ...)
//       }
//   }
//
// The contract lives here, below the framework, so a module needs only this
// (and apogee-container and apogee-config) to describe itself.
import "std"
import "apogee-container"
import "apogee-config"
import "apogee-http"
import "apogee-routing"
import "apogee-auth"
import "grav-db"
use db.*

namespace apogee {

    @Package abstract class ApogeePackage {
        // The package's short name ("sanctum"): its settings live under it.
        abstract fn name() -> string
        // Settings to use when the app's configuration leaves them out (path -> value).
        fn defaults() -> HashMap<string, any> { return new HashMap<string, any>(); }
        // Packages (by name) that must register and boot before this one.
        fn after() -> Array<string> { return new Array<string>(); }
        // Bindings only (other packages may not be registered yet).
        fn register(app: PackageContext) {}
        // Everything else: routes, middleware, listeners, schedules.
        fn boot(app: PackageContext) {}
        // Migrations (grav-orbit Migration objects) run by `migrate`.
        fn migrations() -> Array<any> { return new Array<any>(); }
        // Console commands (apogee-console ConsoleCommand objects).
        fn commands() -> Array<any> { return new Array<any>(); }
        // Whether the package is on (its own setting, "<name>.enabled", true by default).
        fn enabled() -> bool { return Config.getBool(self.name() + ".enabled", true); }
    }

    // What a package sees of the app.
    class PackageContext {
        public container: Container
        // "local", "production", "testing", ...
        public environment: string
        // The app's key (for signing and encryption).
        public key: string
        // The pool a package's own tables are written through (the framework
        // sets it: on SQLite Orbit's connection, so writes join a transaction
        // this thread has open; elsewhere the app's pool).
        public poolFn: fn() -> Pool = null
        constructor(container: Container, environment: string, key: string) { self.container = container; self.environment = environment; self.key = key; }
        fn storePool() -> Pool {
            if (self.poolFn == null) { return self.container.make::<Pool>(); }
            let f = self.poolFn;
            return f();
        }
        // Who may open a package's dashboard: locally anyone on this machine;
        // elsewhere a signed-in user the gate allows `ability` (define it).
        fn dashboardGate(ability: string) -> fn(Request) -> bool {
            let local = self.isLocal();
            let c = self.container;
            return fn(req: Request) -> bool {
                if (local) {
                    let r = req.http.remote;
                    return Str.startsWith(r, "127.") || Str.startsWith(r, "[::1]") || Str.startsWith(r, "::1") || r == "";
                }
                let g = c.make::<Gate>();
                return req.user != null && g.has(ability) && g.allows(req.user, ability);
            };
        }
        // A dashboard's routes: with the session (so the gate knows who is
        // signed in) and only same-origin requests changing anything.
        fn dashboardRoutes(add: fn(Router)) {
            let r = self.make::<Router>();
            r.aliasInstance("same-origin", new SameOriginOnly());
            r.middleware(["session", "same-origin"]).group(fn(g: Router) { add(g); });
        }
        // "a, b,,c" -> ["a", "b", "c"]
        static fn list(s: string) -> Array<string> {
            let out = new Array<string>();
            for (x in Str.split(s, ",")) { if (Str.trim(x) != "") { out.push(Str.trim(x)); } }
            return out;
        }
        fn make<T>() -> T { return self.container.make::<T>(); }
        fn config(path: string, fallback: any = null) -> any { return Config.get(path, fallback); }
        fn isLocal() -> bool { return self.environment == "local"; }
        fn isProduction() -> bool { return self.environment == "production"; }
        fn isTesting() -> bool { return self.environment == "testing"; }
    }

    // Refuses a request that changes something (not GET, HEAD or OPTIONS) when
    // its Origin, or else its Referer, names another site: a browser sends one
    // of them with every cross-site POST, so no other page can press a
    // dashboard's buttons for a signed-in admin. (Without either it is not a
    // browser, so not a forgery.)
    class SameOriginOnly implements Middleware {
        constructor() {}
        fn handle(req: Request, next: fn(Request) -> Response) -> Response {
            let m = req.method();
            if (m == "GET" || m == "HEAD" || m == "OPTIONS") { return next(req); }
            let from = req.header("Origin");
            if (from == "" || from == "null") { from = req.header("Referer"); }
            if (from != "" && SameOriginOnly.hostOf(from) != Str.lower(req.httpHost())) {
                return Response.json({"message": "Cross-site request refused."}, 403);
            }
            return next(req);
        }
        // "https://Example.com:8443/x" -> "example.com:8443"
        static fn hostOf(url: string) -> string {
            let s = url;
            let scheme = Str.indexOf(s, "://");
            if (scheme >= 0) { s = s[scheme + 3..]; }
            let slash = Str.indexOf(s, "/");
            if (slash >= 0) { s = s[..slash]; }
            return Str.lower(s);
        }
    }

    class Packages {
        // The app's folder (set by the framework before defaults are read).
        static basePath: string = "."
        // A path in the app's folder ("storage/app" -> "/srv/app/storage/app").
        static fn path(rel: string) -> string { return Packages.basePath + "/" + rel; }
        // Every package the program holds (each class extending ApogeePackage),
        // made once, in an order that respects after(); names alike: alphabetical.
        static fn discover() -> Array<ApogeePackage> {
            let found = new Array<ApogeePackage>();
            for (cls in ClassInfo.all(reflect(ApogeePackage))) {
                if (!cls.canCreate()) { continue; }
                found.push(cls.create() as ApogeePackage);
            }
            found.sortBy(fn(a: ApogeePackage, b: ApogeePackage) -> int { return Str.compare(a.name(), b.name()); });
            return Packages.ordered(found);
        }
        // `list` with each package after the ones it names in after() (a cycle is a StateError).
        static fn ordered(list: Array<ApogeePackage>) -> Array<ApogeePackage> {
            let byName = new HashMap<string, ApogeePackage>();
            for (p in list) { byName.put(p.name(), p); }
            let out = new Array<ApogeePackage>();
            let done = new HashSet<string>();
            let visiting = new HashSet<string>();
            for (p in list) { Packages.visit(p, byName, done, visiting, out); }
            return out;
        }
        private static fn visit(p: ApogeePackage, byName: HashMap<string, ApogeePackage>, done: HashSet<string>,
                                visiting: HashSet<string>, out: Array<ApogeePackage>) {
            let n = p.name();
            if (done.contains(n)) { return; }
            if (visiting.contains(n)) { throw new StateError("packages wait for each other: " + n); }
            visiting.add(n);
            for (dep in p.after()) {
                let d = byName.getOr(dep, null);
                if (d != null) { Packages.visit(d, byName, done, visiting, out); }
            }
            visiting.remove(n);
            done.add(n);
            out.push(p);
        }
        // Applies each package's defaults where the configuration has no value.
        static fn applyDefaults(list: Array<ApogeePackage>) {
            for (p in list) { for ((k, v) in p.defaults()) { if (!Config.has(k)) { Config.set(k, v); } } }
        }
    }
}
